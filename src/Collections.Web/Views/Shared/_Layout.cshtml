<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Collections</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#main">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4" aria-label="Main navigation">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true">₹</span>Collections
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var currentController = ViewContext.RouteData.Values["controller"] as string;
                    var navItems = new[]
                    {
                        ("Home", "Dashboard"), ("Worklist", "Worklist"), ("Customers", "Customers"), ("Invoices", "Invoices"),
                        ("Payments", "Payments"), ("Promises", "Promises"), ("Reminders", "Reminders"), ("Import", "Import"), ("Settings", "Settings"),
                    };
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            @foreach (var (controller, label) in navItems)
                            {
                                var isActive = string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase);
                                <li class="nav-item">
                                    <a class="nav-link @(isActive ? "active" : null)" aria-current="@(isActive ? "page" : null)"
                                       asp-controller="@controller" asp-action="Index">@label</a>
                                </li>
                            }
                        </ul>
                        <span class="navbar-text me-3 small app-user">@User.Identity?.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container-fluid px-lg-4">
        <main role="main" id="main" class="pb-4">
            <partial name="_StatusMessages" />
            @RenderBody()
        </main>
    </div>
    <footer class="app-footer text-muted small py-3">
        <div class="container-fluid px-lg-4">
            Collections workflow aid – not an accounting ledger. Balances reflect imported and recorded data only.
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
