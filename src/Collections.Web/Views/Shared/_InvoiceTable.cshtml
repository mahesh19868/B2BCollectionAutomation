@model IEnumerable<InvoiceSummary>
@{
    var showCustomer = ViewData["ShowCustomer"] as bool? ?? true;
}
<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Invoice</th>
                @if (showCustomer) { <th scope="col">Customer</th> }
                <th scope="col">Invoice date</th>
                <th scope="col">Due date</th>
                <th scope="col" class="text-end">Amount</th>
                <th scope="col" class="text-end">Outstanding</th>
                <th scope="col" class="text-end">Days overdue</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@i.Id">@i.InvoiceNumber</a></td>
                    @if (showCustomer) { <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@i.CustomerId">@i.CustomerName</a></td> }
                    <td>@Ui.Date(i.InvoiceDate)</td>
                    <td>@Ui.Date(i.DueDate)</td>
                    <td class="text-end">@Ui.Money(i.Financials.InvoiceAmount)</td>
                    <td class="text-end">@Ui.Money(i.Financials.Outstanding)</td>
                    <td class="text-end">@(i.Financials.DaysOverdue > 0 ? i.Financials.DaysOverdue.ToString() : "")</td>
                    <td>
                        @Ui.Tag(Ui.Badge(i.Financials.Status, i.Financials.IsPartiallyPaid))
                        @if (i.Financials.IsPartiallyPaid && i.Financials.Status != InvoiceStatus.NotDue) { <span class="badge text-bg-light border">Part paid</span> }
                        @if (i.IsDisputed) { <span class="badge text-bg-warning">Disputed</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
