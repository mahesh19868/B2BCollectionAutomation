@model (int Page, int TotalPages, int TotalCount)
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination" class="d-flex align-items-center gap-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Ui.PageUrl(Context.Request, Model.Page - 1)" aria-label="Previous page">Previous</a>
            </li>
            <li class="page-item active" aria-current="page"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Ui.PageUrl(Context.Request, Model.Page + 1)" aria-label="Next page">Next</a>
            </li>
        </ul>
        <span class="text-muted small">@Model.TotalCount records</span>
    </nav>
}
else
{
    <p class="text-muted small mb-0">@Model.TotalCount record(s)</p>
}
