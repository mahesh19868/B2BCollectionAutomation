@model PaymentDetail
@{
    ViewData["Title"] = "Payment";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.CustomerName</a></li>
    <li class="breadcrumb-item active" aria-current="page">Payment of @Ui.Date(Model.PaymentDate)</li>
</ol></nav>
<h1 class="h3">Payment @Ui.Money(Model.Amount)</h1>
<dl class="row col-lg-6">
    <dt class="col-5">Customer</dt><dd class="col-7">@Model.CustomerName</dd>
    <dt class="col-5">Payment date</dt><dd class="col-7">@Ui.Date(Model.PaymentDate)</dd>
    <dt class="col-5">Reference</dt><dd class="col-7">@(Model.Reference ?? "—")</dd>
    <dt class="col-5">Unallocated</dt><dd class="col-7">@Ui.Money(Model.Unallocated)</dd>
    @if (Model.Notes is not null)
    {
        <dt class="col-5">Notes</dt><dd class="col-7 text-pre-wrap">@Model.Notes</dd>
    }
</dl>
<h2 class="h5">Allocations</h2>
@if (Model.Allocations.Count == 0)
{
    <p class="text-muted">Not allocated to any invoice.</p>
}
else
{
    <table class="table table-sm col-lg-6">
        <thead><tr><th scope="col">Invoice</th><th scope="col" class="text-end">Allocated</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Allocations)
            {
                <tr><td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@a.InvoiceId">@a.InvoiceNumber</a></td><td class="text-end">@Ui.Money(a.Amount)</td></tr>
            }
        </tbody>
    </table>
}
<a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@Model.Id">Delete payment entered in error…</a>
