@model CustomerFormModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add customer" : "Edit customer";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="col-lg-7" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Customer name (required)</label>
            <input asp-for="Name" class="form-control" maxlength="@Customer.NameMaxLength" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CustomerCode" class="form-label">Customer code</label>
            <input asp-for="CustomerCode" class="form-control" maxlength="@Customer.CodeMaxLength" aria-describedby="codeHelp" />
            <div id="codeHelp" class="form-text">Optional; unique. Used to match import rows.</div>
            <span asp-validation-for="CustomerCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email for reminders</label>
            <input asp-for="Email" type="email" class="form-control" maxlength="@Customer.EmailMaxLength" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" maxlength="@Customer.PhoneMaxLength" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="@Customer.NotesMaxLength"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active customer</label>
            </div>
            <div class="form-check">
                <input asp-for="RemindersPaused" class="form-check-input" />
                <label asp-for="RemindersPaused" class="form-check-label">Pause email reminders for this customer</label>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-link" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Cancel</a>
    </div>
</form>
